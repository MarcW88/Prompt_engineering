# DataForSEO (https://dataforseo.com/)
DATAFORSEO_LOGIN=your_login
DATAFORSEO_PASSWORD=your_password

# Config
CONFIG_PATH=./config/decathlon.yaml
OUTPUT_DIR=./output
LOG_LEVEL=INFO

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Generative engine providers
BRIGHTDATA_API_KEY=
BRIGHTDATA_CHATGPT_DATASET_ID=
BRIGHTDATA_PERPLEXITY_DATASET_ID=
BRIGHTDATA_GEMINI_DATASET_ID=
BRIGHTDATA_GOOGLE_AI_MODE_DATASET_ID=
BRIGHTDATA_FACEBOOK_DATASET_ID=
BRIGHTDATA_INSTAGRAM_DATASET_ID=
BRIGHTDATA_LINKEDIN_DATASET_ID=
BRIGHTDATA_X_DATASET_ID=
BRIGHTDATA_FACEBOOK_COMMENTS_DATASET_ID=
BRIGHTDATA_INSTAGRAM_COMMENTS_DATASET_ID=
BRIGHTDATA_SOCIAL_TIMEOUT=240
BRIGHTDATA_SOCIAL_BATCH_SIZE=20
BRIGHTDATA_SOCIAL_TARGET_LIMIT=20
BRIGHTDATA_SOCIAL_POST_LIMIT=10
BRIGHTDATA_SOCIAL_COMMENT_LIMIT=0
BRIGHTDATA_SOCIAL_COMMENT_TARGET_LIMIT=5
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# Google Cloud Run trigger (non-secret)
GCP_PROJECT_ID=prompt-engineering-worker
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel-pool
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
GCP_REGION=europe-west1
GCP_CLOUD_RUN_JOB=prompt-analysis-worker

# Free source infrastructure (required for the corresponding adapters)
SEARXNG_URL=
GOOGLE_MAPS_SCRAPER_URL=
# Required for ICL and semantic retrieval; missing credentials fail explicitly.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GOOGLE_MAPS_SCRAPER_API_KEY=
